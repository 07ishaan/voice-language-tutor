# Copy this file to ".env". Never commit or share the .env file.
GROQ_API_KEY=paste_your_groq_key_here

# Which character file to use: characters/<name>.json (without .json)
CHARACTER=example-japanese

# Leave empty: the tutor asks Groq which models your key can use and picks one.
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# Voicebox app address (the app must be running)
VOICEBOX_URL=http://localhost:17493
# Optional overrides of the character file:
# VOICEBOX_PROFILE=
# VOICEBOX_ENGINE=
# VOICEBOX_LANGUAGE=
